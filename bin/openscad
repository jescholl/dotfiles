#!/bin/bash
#
# OpenSCAD installs as a .app bundle; its CLI binary is capitalized and
# never lands on $PATH.

# --render takes a value in current OpenSCAD versions -- it's not a bare
# flag. A bare `--render` greedily swallows the very next argument (often
# the .scad filename itself) as its own value, leaving no file argument
# and dumping the full --help text instead of a clear error. Recurred
# across multiple sessions (see claude-notes
# lessons/search-lessons-before-new-domain-mid-session.md, instances 15
# and 16) despite being documented -- fixed here at the tool layer instead
# of relying on remembering to type `--render=true` by hand.
args=()
for arg in "$@"; do
  if [ "$arg" = "--render" ]; then
    args+=("--render=true")
  else
    args+=("$arg")
  fi
done

if [ "$(uname -s)" = "Darwin" ]; then
  exec /Applications/OpenSCAD.app/Contents/MacOS/OpenSCAD "${args[@]}"
else
  exec /usr/bin/openscad "${args[@]}"
fi
